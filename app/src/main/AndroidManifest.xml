<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pobieranie tekstów z LRCLIB -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android Auto: szablon nawigacyjny + własna powierzchnia (Surface) do rysowania -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Android 11+: widoczność Spotify (sprawdzenie instalacji, przycisk "Otwórz Spotify") -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:name=".FadoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fado">

        <!-- Deklaracja aplikacji Android Auto -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Warstwa 1: MediaSession (wymaga dostępu do powiadomień) -->
        <service
            android:name=".sync.SpotifySyncService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Android Auto, tryb 1: tekst w kafelku multimediów obok Map Google.
             W Android Auto wybierz "FA-DO Tekst" jako źródło muzyki. -->
        <service
            android:name=".media.FadoMediaBrowserService"
            android:exported="true"
            android:label="@string/media_service_label">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto, tryb 2: pełnoekranowe karaoke (kategoria NAVIGATION = własna Surface
             w dużym kafelku Coolwalk; zastępuje wtedy Mapy Google) -->
        <service
            android:name=".car.FadoCarAppService"
            android:exported="true"
            android:label="@string/car_nav_label">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
    </application>

</manifest>
