<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Fado" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/fado_surface</item>
        <item name="android:colorPrimaryDark">@color/fado_bg</item>
        <item name="android:colorAccent">@color/fado_accent</item>
        <item name="android:windowBackground">@color/fado_bg</item>
        <item name="android:statusBarColor">@color/fado_bg</item>
        <item name="android:navigationBarColor">@color/fado_bg</item>
        <item name="android:textColorPrimary">@color/fado_text</item>
        <item name="android:textColorSecondary">@color/fado_text_dim</item>
    </style>

    <style name="FadoSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/fado_cyan</item>
    </style>

    <style name="FadoStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/fado_text</item>
    </style>

    <style name="FadoHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/fado_text_dim</item>
    </style>

    <style name="FadoButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:backgroundTint">@color/fado_button</item>
        <item name="android:textColor">@color/fado_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="FadoButton.Accent">
        <item name="android:backgroundTint">@color/fado_accent_dark</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="FadoButton.Small">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
